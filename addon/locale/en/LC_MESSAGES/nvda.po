msgstr "&Clear"

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:95
msgid "&Pegar al foco"
msgstr "&Paste to focus"

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:97
