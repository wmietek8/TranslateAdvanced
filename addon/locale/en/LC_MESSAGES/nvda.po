msgstr "Characters (Alt+5):"

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:281
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:304
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:348
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:436
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:297
msgid "Advertencia"
msgstr "Warning"

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:294
msgid ""
"Se a detectado que el texto de origen es igual que el idioma destino al cual quiere traducirse.\n"
"\n"
"Cambie el idioma destino de traducción si desea continuar."
msgstr ""
"It has been detected that the source text is the same as the target language to which it wants to be translated.\n"
"\n"
"Change the translation target language if you want to continue."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:456
msgid "Texto pegado al foco."
msgstr "Text pasted to focus."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:366
msgid ""
"No se ha podido obtener el audio.\n"
"\n"
"Inténtelo más tarde."
msgstr ""
"Could not get audio.\n"
"\n"
"Please try again later."

