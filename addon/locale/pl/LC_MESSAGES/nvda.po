msgstr "Nie udało się uzyskać tłumaczenia wybranego tekstu."

#: globalPlugins/TranslateAdvanced/__init__.py:857
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:322
msgid ""
"Hubo un error en la traducción:\n"
"\n"
msgstr "W tłumaczeniu wystąpił błąd\n"

#: globalPlugins/TranslateAdvanced/__init__.py:452
msgid "Fallo al borrar la cache de la aplicación {} : {}"
msgstr "Nie udało się wyczyścić pamięci podręcznej aplikacji {}: {}"

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:78
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:252
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:77
msgid "Auto Detectar - auto"
msgstr "Automatyczne wykrywanie - automatyczne"

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:205
msgid ""
"Introduce el texto que deseas traducir. Puedes escribir o pegar el texto "
"aquí."
msgstr ""
"Wpisz tekst, który chcesz przetłumaczyć. Tutaj możesz wpisać lub wkleić "
"tekst."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:206
msgid ""
"El resultado de la traducción se mostrará aquí. Este campo es de solo "
"lectura."
msgstr ""
"Wynik tłumaczenia zostanie wyświetlony tutaj. To pole jest tylko do odczytu."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:207
msgid "Selecciona el idioma de origen para la traducción."
msgstr "Wybierz język źródłowy tłumaczenia."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:208
msgid "Selecciona el idioma de destino para la traducción."
msgstr "Wybierz język docelowy tłumaczenia."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:209
msgid ""
"Presiona este botón para traducir el texto de origen al idioma de destino."
msgstr ""
"Naciśnij ten przycisk, aby przetłumaczyć tekst źródłowy na język docelowy."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:210
msgid "Presiona este botón para escuchar la traducción."
msgstr "Naciśnij ten przycisk, aby odsłuchać tłumaczenie."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:211
msgid "Intercambia los idiomas de origen y destino."
msgstr "Wymień języki źródłowe i docelowe."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:212
msgid "Limpia los campos de texto de origen y destino."
msgstr "Czyści pola tekstowe źródłowe i docelowe."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:213
msgid ""
"Pega al foco lo que haya en el cuadro de texto destino. Se pegara en la "
"ventana que tengamos detrás de esta, siempre y cuando dicha ventana sea "
"cuadro de texto que permita pegar texto en ella. Podemos usar también F3."
msgstr ""
"Wklej wszystko, co znajduje się w docelowym polu tekstowym, aby się skupić. "
"Zostanie wklejony w otwartym za nim oknie, pod warunkiem, że jest to pole "
"tekstowe umożliwiające wklejenie do niego tekstu. Możesz także użyć klawisza"
" F3."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:214
msgid "Cierra la ventana de traducción."
msgstr "Zamknij okno tłumaczenia."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:215
msgid "Muestra el número de caracteres en el campo de texto de origen."
msgstr "Wyświetla liczbę znaków w polu tekstu źródłowego."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:280
msgid "El cuadro de texto de origen está vacío. Por favor, escribe algo."
msgstr "Źródłowe pole tekstowe jest puste. Proszę, napisz coś."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:286
msgid ""
"El texto no ha cambiado. No es necesario realizar una nueva traducción."
msgstr ""
"Tekst się nie zmienił. Nie jest konieczne wykonywanie nowego tłumaczenia."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:301
msgid ""
"No a sido posible detectar el idioma del texto origen.\n"
"\n"
"Se va a intentar traducir, pero no se asegura el éxito de la operación."
msgstr ""
"Nie udało się ustalić języka tekstu źródłowego.\n"
"\n"
"Podjęta zostanie próba tłumaczenia, ale nie można zagwarantować powodzenia operacji."

#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:334
msgid ""
"No se ha encontrado conexión a internet.\n"
"\n"
"Si está conectado por Wifi, puede que NVDA iniciara antes que se conectara.\n"
"\n"
"Si está conectado por cable, compruebe su conexión y asegúrese de que todo esté correcto.\n"
"\n"
