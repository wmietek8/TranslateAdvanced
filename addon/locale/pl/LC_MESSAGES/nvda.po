#: globalPlugins/TranslateAdvanced/__init__.py:335
msgid "Abre la configuración del complemento"
msgstr "Otwórz ustawienia dodatku"

#: globalPlugins/TranslateAdvanced/__init__.py:347
msgid "Comprueba si hay actualizaciones de idioma del complemento"
msgstr "Sprawdź dostępność aktualizacji językowych dodatków"

#: globalPlugins/TranslateAdvanced/__init__.py:359
msgid "Cambiar idioma de origen"
msgstr "Zmień język źródłowy"

#: globalPlugins/TranslateAdvanced/__init__.py:373
msgid "Cambiar idioma de destino"
msgstr "Zmień język docelowy"

#: globalPlugins/TranslateAdvanced/__init__.py:384
msgid "Cambiar el modulo de traducción"
msgstr "Zmień moduł tłumaczeniowy"

#: globalPlugins/TranslateAdvanced/__init__.py:395
msgid "Eliminar todas las traducciones en caché para todas las aplicaciones"
msgstr "Usuń wszystkie buforowane tłumaczenia dla wszystkich aplikacji"

#: globalPlugins/TranslateAdvanced/__init__.py:426
msgid ""
"Eliminar la caché de traducción para la aplicación enfocada actualmente"
msgstr "Usuń pamięć podręczną tłumaczeń dla aktualnie aktywnej aplikacji"

#: globalPlugins/TranslateAdvanced/__init__.py:457
msgid "Activa o desactiva la cache de traducción"
msgstr "Włącz lub wyłącz pamięć podręczną tłumaczeń"

#: globalPlugins/TranslateAdvanced/__init__.py:496
msgid "Copiar el ultimo texto traducido al portapapeles"
msgstr "Skopiuj ostatni przetłumaczony tekst do schowka"

#: globalPlugins/TranslateAdvanced/__init__.py:516
msgid "Traduce el contenido del portapapeles"
msgstr "Tłumaczenie zawartości schowka"

#: globalPlugins/TranslateAdvanced/__init__.py:544
msgid "Traduce el último texto verbalizado"
msgstr "Przetłumacz ostatnio wypowiadany tekst"

#: globalPlugins/TranslateAdvanced/__init__.py:572
msgid "Activa o desactiva la traducción simultánea Online"
msgstr "Włącz lub wyłącz tłumaczenie online w czasie rzeczywistym"

#: globalPlugins/TranslateAdvanced/__init__.py:591
msgid "Traduce el texto seleccionado"
msgstr "Przetłumacz zaznaczony tekst"

#: globalPlugins/TranslateAdvanced/__init__.py:610
msgid "Muestra el historial de traducción"
msgstr "Wyświetla historię tłumaczeń"

#: globalPlugins/TranslateAdvanced/__init__.py:624
#: globalPlugins/TranslateAdvanced/app/managers/managers_settings.py:142
msgid "Detecta el idioma seleccionado"
msgstr "Wykrywa wybrany język"

#: globalPlugins/TranslateAdvanced/__init__.py:655
msgid ""
"Activar o desactivar el intercambio automático si el origen detectado "
"coincide con el destino (experimental)"
msgstr ""
"Włącz lub wyłącz automatyczne tłumaczenie, jeśli wykryte źródło pasuje do "
"miejsca docelowego (eksperymentalnie)"

#: globalPlugins/TranslateAdvanced/__init__.py:673
#: globalPlugins/TranslateAdvanced/app/managers/managers_settings.py:144
msgid "Intercambia el idioma principal con el idioma alternativo."
msgstr "Zamień język podstawowy na język alternatywny."

#: globalPlugins/TranslateAdvanced/__init__.py:711
msgid "Traduce texto del objeto del navegador"
msgstr "Przetłumacz tekst z obiektu przeglądarki"

#: globalPlugins/TranslateAdvanced/__init__.py:755
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:28
msgid "Interfaz de traducción"
msgstr "Interfejs tłumaczeniowy"

#: globalPlugins/TranslateAdvanced/__init__.py:202
msgid ""
"Tiene la traducción simultanea activada.\n"
"\n"
"Desactívela para realizar esta acción."
msgstr ""
"Masz włączone tłumaczenie w czasie rzeczywistym.\n"
"\n"
"Wyłącz go, aby wykonać tę akcję."

#: globalPlugins/TranslateAdvanced/__init__.py:422
msgid "El directorio de la cache no existe."
msgstr "Katalog pamięci podręcznej nie istnieje."

#: globalPlugins/TranslateAdvanced/__init__.py:424
msgid "Se ha eliminado toda la cache."
msgstr "Cała pamięć podręczna została usunięta."

#: globalPlugins/TranslateAdvanced/__init__.py:424
msgid "No se a podido eliminar toda la cache."
msgstr "Nie można usunąć całej pamięci podręcznej."

#: globalPlugins/TranslateAdvanced/__init__.py:84
msgid ""
"Se a encontrado errores en la carga del complemento.\n"
"\n"
"Error:\n"
"\n"
"{}"
msgstr ""
"Wystąpiły błędy podczas ładowania wtyczki.\n"
"\n"
"Błąd:\n"
"\n"
"{}"

