msgid "&Actualizar idiomas del complemento ({} actualizaciones disponibles)"
msgstr "&Aktualizuj języki wtyczek (dostępne aktualizacje {})"

#: globalPlugins/TranslateAdvanced/__init__.py:443
msgid ""
"Pulse dos veces para eliminar todas las traducciones de {} en lenguaje {}"
msgstr ""
"Naciśnij szybko dwa razy, aby usunąć wszystkie tłumaczenia {} na język {}"

#: globalPlugins/TranslateAdvanced/__init__.py:450
msgid "Se ha borrado la cache de la aplicación {} correctamente."
msgstr "Pamięć podręczna aplikacji {} została pomyślnie wyczyszczona."

#: globalPlugins/TranslateAdvanced/__init__.py:511
msgid "Se ha copiado lo siguiente al portapapeles: {}"
msgstr "Do schowka skopiowano: {}"

#: globalPlugins/TranslateAdvanced/__init__.py:740
msgid "El objeto no tiene texto para traducir"
msgstr "Obiekt nie zawiera tekstu do przetłumaczenia"

#: globalPlugins/TranslateAdvanced/__init__.py:852
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:312
