#: globalPlugins/TranslateAdvanced/__init__.py:129
msgid "&Traductor Avanzado"
msgstr "&Zaawansowany tłumacz"

#: globalPlugins/TranslateAdvanced/__init__.py:130
msgid "&Configuración de Traductor Avanzado"
msgstr "&Zaawansowana konfiguracja tłumacza"

#: globalPlugins/TranslateAdvanced/__init__.py:131
#: globalPlugins/TranslateAdvanced/__init__.py:318
msgid "&Actualizar idiomas del complemento (Sin actualizaciones)"
msgstr "&Aktualizuj języki wtyczek (Brak aktualizacji)"

#: globalPlugins/TranslateAdvanced/__init__.py:132
msgid "&Documentación del complemento"
msgstr "&Dokumentacja dodatków"

#: globalPlugins/TranslateAdvanced/__init__.py:133
msgid "&invítame a un café si te gusta mi trabajo"
msgstr "&i podaruj kawę, jeśli podoba Ci się moja praca"

#: globalPlugins/TranslateAdvanced/__init__.py:140
msgid "Traductor Avanzado iniciado correctamente."
msgstr "Zaawansowany tłumacz został pomyślnie uruchomiony."

#: globalPlugins/TranslateAdvanced/__init__.py:144
msgid "Traductor Avanzado iniciado con errores."
msgstr "Zaawansowany tłumacz uruchomił się z błędami."

#: globalPlugins/TranslateAdvanced/__init__.py:178
#: globalPlugins/TranslateAdvanced/app/guis/guis_guitrans.py:269
msgid ""
"No se a encontrado conexión a internet.\n"
"\n"
"Si esta conectado por Wifi puede que NVDA iniciara antes que se conectara.\n"
"\n"
"Si esta conectado por cable compruebe su conexión y asegúrese que todo esta correcto.\n"
"\n"
"Espere unos segundos."
msgstr ""
"Nie znaleziono połączenia internetowego.\n"
"\n"
"Jeśli jesteś podłączony przez Wi-Fi, NVDA mogła zostać uruchomiona przed połączeniem.\n"
"\n"
"Poczekaj kilka sekund i zrestartuj NVDA.\n"
"\n"
"Jeżeli łączysz się kablem, sprawdź połączenie i upewnij się, że wszystko jest w porządku."

#: globalPlugins/TranslateAdvanced/__init__.py:189
msgid ""
"Ya hay una instancia de Traductor Avanzado abierta.\n"
"\n"
"Ciérrela para realizar esta acción."
msgstr ""
"Instancja zaawansowanego tłumacza jest już uruchomiona.\n"
"\n"
"Aby wykonać tę akcję, musisz je zamknąć."

#: globalPlugins/TranslateAdvanced/__init__.py:196
msgid "Tiene una traducción en curso. Espere a que termine."
msgstr "Obecnie trwa tłumaczenie. Poczekaj, aż to się skończy."

#: globalPlugins/TranslateAdvanced/__init__.py:241
msgid ""
"_Activa la capa de comandos. F1 muestra la lista de atajos de una sola tecla"
msgstr "_Aktywuje warstwę poleceń. F1 pokazuje listę skrótów klawiszowych"

